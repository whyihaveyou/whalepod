{
  "$schema": "dfh-design-tokens/v1",
  "meta": {
    "source": "design/tokens/tokens.css",
    "defaultTheme": "dark",
    "note": "唯一 token 源；桌面壳与团队面板共用。暗色为默认主题（dark-first），light 为可切换主题。"
  },
  "color": {
    "brand": {
      "primary": { "dark": "#8FA4FF", "light": "#4D6BFE" },
      "primaryStrong": "#4D6BFE",
      "violet": "#7A4DFF",
      "gradient": "linear-gradient(135deg, #5B7CFF, #7A4DFF)",
      "spark": "#22D3EE"
    },
    "semantic": {
      "success": { "dark": "#4ADE80", "light": "#16A34A" },
      "warning": { "dark": "#FBBF24", "light": "#D97706" },
      "danger":  { "dark": "#F87171", "light": "#DC2626" },
      "info":    { "dark": "#8FA4FF", "light": "#4D6BFE" }
    },
    "surface": {
      "bgApp":      { "dark": "#0D1020", "light": "#F7F8FC" },
      "bgSurface":  { "dark": "#161A2E", "light": "#FFFFFF" },
      "bgSunken":   { "dark": "#0A0D1A", "light": "#EFF1F8" },
      "bgElevated": { "dark": "#1D2340", "light": "#FFFFFF" },
      "bgOverlay":  { "dark": "rgba(4,6,16,.6)", "light": "rgba(26,29,46,.35)" }
    },
    "text": {
      "primary":   { "dark": "#E8EAF6", "light": "#1A1D2E" },
      "secondary": { "dark": "#9AA0BE", "light": "#5A6072" },
      "tertiary":  { "dark": "#7E86A0", "light": "#6B7280", "note": "meta 文字（时间戳/系统条/id），卡 AA 4.5:1 下限" },
      "disabled":  { "dark": "#565C78", "light": "#9BA1B5", "note": "仅 placeholder/装饰，不做正文级文字" }
    },
    "border": {
      "default": { "dark": "#262B45", "light": "#E2E5F0" },
      "strong":  { "dark": "#3A4066", "light": "#C9CEDF" }
    },
    "accent": {
      "default": { "dark": "#8FA4FF", "light": "#4D6BFE" },
      "hover":   { "dark": "#A9BAFF", "light": "#3B5BEE" },
      "subtle":  { "dark": "rgba(143,164,255,.16)", "light": "rgba(77,107,254,.12)" },
      "fill":      { "dark": "#4D6BFE", "light": "#4D6BFE" },
      "fillHover": { "dark": "#5B7CFF", "light": "#3B5BEE" },
      "textOnAccent": "#FFFFFF"
    },
    "status": {
      "active":   "accent-spark (#22D3EE) — agent working / 任务 in_progress",
      "idle":     { "dark": "#6E7692", "light": "#848BA1", "note": "状态点/图形，全表面 ≥3:1；状态文字一律用 text-secondary（disabled 色对比度不足，QA 否决）" },
      "pending":  "text-secondary — 任务 pending（空心/虚线）",
      "done":     "success — 完成",
      "danger":   "danger — failed / 错误",
      "warn":     "warning — blocked / 等待审批",
      "progress": "brand-violet (#7A4DFF) — spawning / typing / 生成中",
      "offline":  { "dark": "#6E7692", "light": "#848BA1", "note": "空心点，形状区分 idle" }
    }
  },
  "font": {
    "ui": "Inter, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif",
    "display": "'Space Grotesk', Inter, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "scale": {
      "xs":   { "size": 11,   "lineHeight": 16 },
      "sm":   { "size": 12,   "lineHeight": 18 },
      "base": { "size": 14,   "lineHeight": 22 },
      "md":   { "size": 17.5, "lineHeight": 26 },
      "lg":   { "size": 22,   "lineHeight": 30 },
      "xl":   { "size": 27.5, "lineHeight": 36 }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24 },
  "radius": { "sm": 4, "md": 6, "lg": 10, "xl": 14, "full": 999 },
  "shadow": {
    "1":       { "dark": "none", "light": "0 1px 2px rgba(26,29,46,.06)" },
    "popover": { "dark": "0 4px 16px rgba(0,0,0,.4)", "light": "0 4px 16px rgba(26,29,46,.10)" },
    "modal":   { "dark": "0 12px 40px rgba(0,0,0,.55)", "light": "0 12px 40px rgba(26,29,46,.18)" }
  },
  "motion": { "fast": 100, "base": 160, "slow": 240, "easeOut": "cubic-bezier(.2,.8,.3,1)" },
  "layout": {
    "titlebar": 40, "statusbar": 24,
    "navCollapsed": 56, "navExpanded": 200,
    "listMin": 280, "listMax": 420, "listItem": 48, "input": 32
  }
}
